{
  "manifest_version": 3,
  "name": "Turing Arena Probe",
  "version": "0.1.34",
  "description": "Capture human GUI trajectories for Turing Arena models.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "webRequest",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Turing Arena Probe",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true
    }
  ]
}